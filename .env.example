# Resume Screener — environment (NON-SECRET values only; see CLAUDE.md §8)
# Copy to .env and fill in the TODOs. API keys live ONLY in Azure Key Vault —
# these *_SECRET vars are the Key Vault SECRET NAMES, not the keys themselves.

AZURE_KEY_VAULT_URI=https://your-keyvault.vault.azure.net/
AZURE_OPENAI_API_KEY_SECRET=azure-openai-api-key
DOCUMENTINTELLIGENCE_API_KEY_SECRET=document-intelligence-api-key

AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=TODO
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=TODO

DOCUMENTINTELLIGENCE_ENDPOINT=https://your-docintel.cognitiveservices.azure.com/

# Optional (see CLAUDE.md §0)
AZURE_TENANT_ID=00000000-0000-4000-8000-2200910f4d4b
AZURE_SUBSCRIPTION_ID=00000000-0000-4000-8000-b361bdfa266c

# Database. Local dev default matches docker-compose.yml (localhost creds only —
# NOT a secret). In prod, point this at Azure Database for PostgreSQL WITHOUT a
# password; the app attaches an Entra token automatically (passwordless), e.g.:
#   postgresql+psycopg://<app-identity>@<server>.postgres.database.azure.com:5432/screener?sslmode=require
DATABASE_URL=postgresql+psycopg://screener:screener@localhost:5432/screener

# Per-domain storage backend switches. EVERY default keeps the zero-DB-infra
# behavior (flat files / in-memory); set a domain to its "db" value to read/write
# that domain from Postgres instead. The contract callers see is identical either
# way. Adopt the database domain-by-domain, or set them all to "db" at once. See
# 10-DATA-MODEL.md for what each domain moves. Setup once the DB is up:
#   docker compose up -d db && screener db upgrade && screener db import && screener db seed
# Hosting (P26/P27) — normally set on the Container App, not here:
#   DATA_ROOT=/data      root for ALL mutable state (unset/"." = repo root, local default)
#   DEV_USER=you.test@x.com  local identity shown as the reviewer (SSO supplies it when hosted;
#                             default arjun.test@example.com — keep 'test' in demo emails)
#   DEV_ROLE=SuperAdmin  local role(s), comma list ok (default SuperAdmin): HRHead | Legal | IT | TASpecialist |
#                        HRSpecialist | HiringManager | SuperAdmin (P36 unions them)

# --- Authentication: pick ONE of three entry paths ----------------------------------
#
# APP_MODE = dev | uat | prod        (the switch; everything below is detail)
#
#   dev   no sign-in at all. Identity is DEV_USER/DEV_ROLE and the in-app role switcher
#         is live, so every role is reachable without Entra. LOCAL DEVELOPMENT ONLY.
#   uat   real Entra sign-in, run by the APP ITSELF against the Resume-Screener-Dev
#         registration (no Easy Auth in front). Needs ENTRA_TENANT_ID +
#         ENTRA_CLIENT_ID below, the `easyauth-client-secret` Key Vault secret, an
#         app-role assignment and a region grant for each tester's UPN.
#   prod  real Entra sign-in via App Service Easy Auth in front of the container. The
#         app never sees a token, only the injected principal header.
#
# All three satisfy ONE identity contract — rbac.py reads only X-MS-CLIENT-PRINCIPAL —
# so the modes differ in WHO completes the OIDC dance, never in how authorization works.
# `screener check` prints the active mode and a per-mode preflight.
#
# FAIL SAFE: leave APP_MODE unset locally and you get `dev`; leave it unset on App
# Service and you get `prod` (the strictest), never dev. Forgetting to configure a
# deployment costs a locked door, not an open one.
#
#   APP_MODE=dev
#
# ⚠ UAT IS BLOCKED ON AN IT ACTION, not on configuration. Entra admin consent has NOT
# been granted for this registration (verified 2026-08-20: it has zero
# oauth2PermissionGrants, and only User.Read is configured — not openid/profile/email).
# Until an admin grants it, every first sign-in stops at "Need admin approval" and no
# code change gets past it. Tracked on ISM-274462; see docs/13-UAT-DEPLOYMENT.md §9.
#
# ENTRA_TENANT_ID / ENTRA_CLIENT_ID — required by `uat`. NOT secrets (they are public
# identifiers) but deliberately NOT in source: Acme's ADC validator rejects any
# identity GUID in code, and a wrong tenant baked into an image is invisible until
# someone tries to sign in. Hosted, these arrive as App Service app settings.
# ENTRA_TENANT_ID falls back to AZURE_TENANT_ID when unset.
#   ENTRA_TENANT_ID=
#   ENTRA_CLIENT_ID=
#
# The three flags below still work and OVERRIDE the mode's default, so an existing
# deployment keeps its exact behaviour until APP_MODE is set on it. New setups should
# use APP_MODE and leave these alone.
#
# REQUIRE_SSO=1 — SET THIS IN EVERY HOSTED ENVIRONMENT. Without it, a request carrying
# no Easy-Auth principal falls back to DEV_USER/DEV_ROLE, i.e. DEFAULT_ROLE =
# SuperAdmin. That is not theoretical: UAT served anonymous SuperAdmin with all 15
# capabilities against a populated database until 2026-08-14. `DEV_SWITCH=0` does NOT
# cover this — it only disables the x-dev-user/x-dev-role headers, not the env fallback.
# With REQUIRE_SSO=1 an unauthenticated request gets no identity and no capabilities
# (the "access not configured" page). Leave it UNSET locally.
#   REQUIRE_SSO=1
#
# LOCAL_SSO=1 — what APP_MODE=uat turns on, available on its own for a one-off local
# test of the real sign-in flow. Real Entra sign-in without Easy Auth. Runs the
# auth-code flow and synthesizes the same X-MS-CLIENT-PRINCIPAL header App Service
# injects, so rbac.py is identical in both places. Needs the Key Vault secret
# `easyauth-client-secret` (fetched at runtime via your `az login`) and an app-role
# assignment + region grant for your UPN, exactly like hosted.
#   BROWSE http://localhost:8000 — NOT http://127.0.0.1:8000. Entra treats those as
#   different redirect URIs, and 127.0.0.1 is not registered: you get AADSTS50011.
#   LOCAL_SSO=1

# Feature flags (P37). Most flags are edited from the Governance -> Feature flags page
# and stored in signals/features.yaml. The hiring-manager portal is deployment-controlled
# ONLY (not editable in-app): unset/0 = dark (the hm_take capability is stripped everywhere).
FEATURE_HM_PORTAL=0
# Careers-portal auto-fill (TEMPORARY iCIMS bridge): on iCIMS-Req-ID blur, the New-req
# form fetches title/location/JD from the public careers site. Deployment-controlled;
# 1 = on (pilot default), unset/0 = off.
FEATURE_CAREERS_AUTOFILL=1

FEEDBACK_BACKEND=jsonl          # decisions log        (jsonl | db)
GOVERNANCE_BACKEND=jsonl        # audit + review       (jsonl | db)
RUN_INDEX_BACKEND=file          # screening-run index  (file  | db)
JOBS_BACKEND=memory             # screening job state  (memory| db)
REGISTRY_BACKEND=file           # signal registry      (file  | db)
POLICY_BACKEND=file             # jurisdiction packs   (file  | db)
RUBRIC_BACKEND=file             # versioned rubrics    (file  | db)
REQUISITIONS_BACKEND=file       # JD/requisition ident (file  | db)
PREFS_BACKEND=jsonl             # HR preferences (P49)  (jsonl | db)
EVENTS_BACKEND=jsonl            # app-event spine (P49) (jsonl | db)
HM_TAKES_BACKEND=jsonl          # hiring-manager takes  (jsonl | db)
FLAGS_BACKEND=yaml              # feature flags (P49)   (yaml  | db)

# Today (10-Sep-2026): the app, its database and the Azure Files share are in Central India;
# Azure OpenAI and Document Intelligence are in East US (docs/13-UAT-DEPLOYMENT.md §R-7). 
# Every residency argument written in this repository is about India → US under the DPDP Act.
# Nothing addresses EU → India or US → India.

# That is a question for HR, Legal and the Cloud Admin, not something an implementation can
# decide. What the code does now is refuse to hide it: PROCESSING_LOCATIONS (plain text, unset
# = nothing shown) surfaces in the hiring-rules popover, the New-requisition note and screener
# check.

# Suggested value while the app is hosted as it is:

PROCESSING_LOCATIONS="Files and database: Central India · AI processing: East US"